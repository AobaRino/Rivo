# Independent table, patterned after Nikki's LAN TPROXY separation. No OUTPUT
# hook: core egress, subscription downloads and router administration stay direct.
table inet mihomo_manager {
  set bypass4 {
    type ipv4_addr
    flags interval
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
      169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
      192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
      224.0.0.0/4, 240.0.0.0/4 }
  }
  chain dns_redirect {
    type nat hook prerouting priority dstnat - 1; policy accept;
    iifname "br-lan" meta nfproto ipv4 meta l4proto { tcp, udp } th dport 53 counter redirect to :53
  }
  chain lan_proxy {
    type filter hook prerouting priority mangle; policy accept;
    iifname != "br-lan" return
    meta nfproto != ipv4 return
    # Replies from LAN services (including WAN port forwards) must keep their
    # original conntrack/NAT path instead of entering the transparent proxy.
    ct direction reply counter return
    fib daddr type { local, broadcast, anycast, multicast } return
    meta l4proto { tcp, udp } th dport 53 return
    ip daddr @bypass4 return
    meta l4proto { tcp, udp } counter meta mark set meta mark | 0x01000000 tproxy ip to 127.0.0.1:17891 accept
  }
}
