#!/bin/sh /etc/rc.common
USE_PROCD=1
START=97
STOP=8
start_service() {
    [ ! -e /etc/mihomo-manager.disabled ] || return 0
    procd_open_instance watchdog
    procd_set_param command /usr/libexec/mihomo-manager-network watch
    procd_set_param respawn 3600 2 10
    procd_set_param term_timeout 10
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
stop_service() {
    /usr/libexec/mihomo-manager-network off
}
