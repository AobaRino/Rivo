#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=9
start_service() {
    [ ! -e /etc/mihomo-manager.disabled ] || return 0
    [ -x /usr/libexec/mihomo-manager-core ] || return 1
    [ -s /etc/mihomo-manager-runtime/active.yaml ] || return 1
    mkdir -p /var/run/mihomo-manager-core
    chmod 0700 /var/run/mihomo-manager-core
    local revision
    revision=$(sha256sum /etc/mihomo-manager-runtime/active.yaml)
    revision=${revision%% *}
    [ -d "/etc/mihomo-manager-runtime/data/$revision" ] || return 1
    procd_open_instance core
    procd_set_param command /usr/libexec/mihomo-manager-core \
        -d "/etc/mihomo-manager-runtime/data/$revision" \
        -f /etc/mihomo-manager-runtime/active.yaml \
        -ext-ctl-unix /var/run/mihomo-manager-core/control.sock
    procd_set_param respawn 3600 2 10
    procd_set_param limits core="0" nofile="65536 65536"
    procd_set_param term_timeout 10
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
