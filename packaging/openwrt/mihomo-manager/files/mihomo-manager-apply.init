#!/bin/sh /etc/rc.common
USE_PROCD=1
start_service() {
    [ ! -e /etc/mihomo-manager.disabled ] || return 0
    procd_open_instance apply
    procd_set_param command /usr/bin/mihomo-manager router-apply
    procd_set_param term_timeout 5
    procd_set_param limits core="0"
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
