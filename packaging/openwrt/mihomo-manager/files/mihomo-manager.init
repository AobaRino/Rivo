#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
	[ ! -e /etc/mihomo-manager.disabled ] || return 0
	# Only directories owned by this package. No UCI, network or other services.
	local path
	for path in /etc/mihomo-manager /var/run/mihomo-manager; do
		[ ! -L "$path" ] || return 1
		mkdir -p "$path" || return 1
		chown mihomomgr:mihomomgr "$path" || return 1
		chmod 0700 "$path" || return 1
	done
	local host port cert key
	config_load network
	config_get host lan ipaddr
	host="${host%%/*}"
	config_load mihomo-manager
	config_get port web port 18888
	mkdir -p /var/run/mihomo-manager-broker
	chown root:mihomomgr /var/run/mihomo-manager-broker
	chmod 0710 /var/run/mihomo-manager-broker
	# Use the router's configured certificate when present, without depending on
	# uhttpd at runtime. Otherwise the application creates its own certificate.
	cert="$(uci -q get uhttpd.main.cert)"
	key="$(uci -q get uhttpd.main.key)"
	if [ -s "$cert" ] && [ -s "$key" ]; then
		cp "$cert" /var/run/mihomo-manager-broker/web.crt
		cp "$key" /var/run/mihomo-manager-broker/web.key
		chown root:mihomomgr /var/run/mihomo-manager-broker/web.crt /var/run/mihomo-manager-broker/web.key
		chmod 0640 /var/run/mihomo-manager-broker/web.crt /var/run/mihomo-manager-broker/web.key
	fi
	procd_open_instance broker
	procd_set_param command /usr/bin/mihomo-manager router-broker
	procd_set_param respawn 3600 5 3
	procd_set_param term_timeout 5
	# rc.common / procd_lock reserves descriptor 1000 when starting apply jobs.
	# Children inherit this hard limit; 512 makes exec fail before the job starts.
	procd_set_param limits core="0" nofile="2048 2048"
	procd_close_instance
	procd_open_instance manager
	# The daemon applies no_new_privs to every Go thread before serving requests.
	procd_set_param command /usr/bin/mihomo-manager router
	procd_set_param env MIHOMO_WEB_HOST="$host" MIHOMO_WEB_PORT="$port"
	procd_set_param user mihomomgr
	procd_set_param group mihomomgr
	procd_set_param respawn 3600 5 3
	procd_set_param term_timeout 10
	procd_set_param limits core="0" nofile="512 512"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
